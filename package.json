{
  "name": "lexware-mcp",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source, self-hostable MCP server for the Lexware Office API",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "tsc -b --force",
    "start": "node dist/server.js",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "skybridge": "^2.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@skybridge/devtools": "^2.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
