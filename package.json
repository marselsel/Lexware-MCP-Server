{
  "name": "lexware-mcp",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "description": "Open-source, self-hostable MCP server for the Lexware Office API",
  "type": "module",
  "scripts": {
    "dev": "skybridge dev",
    "dev:tunnel": "skybridge dev --tunnel",
    "build": "tsc -b --force",
    "start": "NODE_ENV=production node dist/server.js",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "jose": "^6.2.14",
    "skybridge": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@skybridge/devtools": "^2.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
